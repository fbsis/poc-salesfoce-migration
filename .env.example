# ---------------------------------------------------------------- database
DATABASE_URL=postgres://poc:poc@postgres:5432/poc_crm
TEST_DATABASE_URL=postgres://poc:poc@postgres:5432/poc_crm_test

# ------------------------------------------------------------------- CRM API
# Bearer token used by the MCP server (and any external client) against
# /api/crm/*. The UI does not need it: it calls the service layer directly.
CRM_API_TOKEN=poc-local-token
CRM_API_BASE_URL=http://web:3000

# ----------------------------------------------------------------------- MCP
MCP_PORT=3001
MCP_AUTH_TOKEN=poc-local-token

# ---------------------------------------------------------------- Salesforce
# SF_USE_MOCK=true routes every Salesforce call to the local mock service
# (apps/salesforce-mock). Set to false and fill the credentials below to point
# at a real org.
SF_USE_MOCK=true
SF_LOGIN_URL=https://login.salesforce.com
SF_INSTANCE_URL=https://your-instance.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_API_VERSION=v62.0

# Pub/Sub API (gRPC)
PUBSUB_ENDPOINT=localhost:50051
PUBSUB_TOPIC=/data/AccountChangeEvent
PUBSUB_TOPIC_OPPORTUNITY=/data/OpportunityChangeEvent
PUBSUB_TOPIC_CONTACT=/data/ContactChangeEvent
PUBSUB_TOPIC_LEAD=/data/LeadChangeEvent
PUBSUB_REPLAY_PRESET=LATEST
